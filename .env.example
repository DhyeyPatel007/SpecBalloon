# SpecBalloon Environment Configuration

# Frontend: URL of the FastAPI backend
VITE_BACKEND_URL=http://localhost:8000

# Backend: Optional configuration
# SQLITE_DB_PATH=/tmp/specballoon.db
# UPLOAD_TMP_DIR=/tmp/specballoon_uploads
# GEMINI_API_KEY=
# GEMINI_API_KEY_2=  # optional second Gemini key: automatic fallback if key 1 is rate-limited (429)
# GEMINI_HYDROGEN_LATCH_TTL_HOURS=4  # how long a 429-latched key stays off before auto-retry
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://spec-balloon.vercel.app

